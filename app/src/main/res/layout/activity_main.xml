<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img"
    tools:context=".MainActivity">

    <!-- ========================================== -->
    <!-- BANNER FIJO ARRIBA - SIEMPRE VISIBLE -->
    <!-- ========================================== -->
    <com.google.android.gms.ads.AdView
        android:layout_marginTop="20dp"
        android:id="@+id/adViewBannerBottom"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        app:adSize="LARGE_BANNER"
        app:adUnitId="ca-app-pub-6378961597427920/3155691078" />

    <!-- ========================================== -->
    <!-- CONTENIDO SCROLLEABLE - DEBAJO DEL BANNER -->
    <!-- ========================================== -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/adViewBannerBottom"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <!-- ========================================== -->
            <!-- Título + Settings -->
            <!-- ========================================== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="CalculaYa"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:shadowColor="@color/white"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="6"/>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:background="@null"
                    android:src="@drawable/ic_settings_gear"
                    android:contentDescription="Configuración de tarifas" />
            </RelativeLayout>

            <!-- ========================================== -->
            <!-- Ciudad y Grupo -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tVCiudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciudad: Trelew"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                tools:text="Ciudad: Trelew"/>

            <TextView
                android:id="@+id/tVGrupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grupo: 1"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:layout_marginBottom="15dp"
                android:textStyle="bold"
                tools:text="Grupo: 1"/>

            <!-- ========================================== -->
            <!-- Selector de Modo (RadioGroup) -->
            <!-- ========================================== -->
            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="15dp">

                <RadioButton
                    android:id="@+id/rbSimple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido Simple"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:buttonTint="@color/black"
                    android:checked="true"
                    android:layout_marginEnd="20dp"/>

                <RadioButton
                    android:id="@+id/rbGrouped"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agrupados"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:buttonTint="@color/black"/>
            </RadioGroup>

            <!-- ========================================== -->
            <!-- Distancia al Local -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Distancia al Local"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTextDistanciaLocal"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:background="@color/white"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- Distancia al punto de entrega -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Distancia al punto de entrega"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editTextDistanciaEntrega"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:background="@color/white"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- CONTENEDOR PEDIDOS AGRUPADOS (EXTRA) -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layoutExtraDeliveries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="0dp"/>

            <Button
                android:id="@+id/btnAddDeliveryPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar punto de entrega"
                android:visibility="gone"
                android:layout_marginTop="5dp"
                android:backgroundTint="@color/black"
                android:textColor="@color/white"/>

            <!-- ========================================== -->
            <!-- Botones + / - -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview_minus"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="4dp"
                    android:layout_marginHorizontal="20dp"
                    app:cardBackgroundColor="@color/white">
                    <ImageView
                        android:id="@+id/imgButtonMinus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/img_boton_resta" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview_plus"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="4dp"
                    android:layout_marginHorizontal="20dp"
                    app:cardBackgroundColor="@color/white">
                    <ImageButton
                        android:id="@+id/imgButtonPlus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_boton_suma"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:padding="8dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- Botón Calcular -->
            <!-- ========================================== -->
            <Button
                android:id="@+id/buttonCalcular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calcular"
                android:textColor="@color/white"
                android:layout_margin="10dp"
                android:backgroundTint="@color/black"/>

            <!-- ========================================== -->
            <!-- Resultado -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tVMonto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Monto Estimado: "
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <Button
                android:id="@+id/btnVerDetalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver Detalles"
                android:layout_marginTop="10dp"
                android:visibility="gone"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#F0F0F0"
                app:cardCornerRadius="8dp"
                app:contentPadding="10dp">

                <TextView
                    android:id="@+id/tvDetalleBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detalles del cálculo..."
                    android:textColor="@color/black"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>